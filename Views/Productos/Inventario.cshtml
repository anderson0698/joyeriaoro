@model IEnumerable<Joyeriaoro.Models.Producto>

@{
    ViewData["Title"] = "Inventario";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>

    body {
        background: #f4f7fb;
    }

    .page-title {
        font-weight: 700;
        color: #111827;
    }

    .inventory-card {
        border: none;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(0,0,0,0.06);
    }

    .inventory-header {
        background: linear-gradient(135deg,#111827,#1e3a8a);
        color: white;
        padding: 25px;
    }

    .table thead {
        background: #111827;
        color: white;
    }

    .table tbody tr {
        transition: 0.2s;
    }

        .table tbody tr:hover {
            background: #f8fafc;
            transform: scale(1.002);
        }

    .product-img {
        width: 75px;
        height: 75px;
        object-fit: cover;
        border-radius: 12px;
        border: 2px solid #e5e7eb;
    }

    .badge-custom {
        padding: 8px 14px;
        border-radius: 20px;
        font-size: 13px;
    }

    .btn-custom {
        border-radius: 12px;
        padding: 10px 18px;
        font-weight: 600;
    }

    .empty-img {
        width: 75px;
        height: 75px;
        background: #e5e7eb;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6b7280;
        font-size: 30px;
    }

</style>

<div class="container-fluid mt-4">

    <!-- TITULO -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1 class="page-title">
                <i class="bi bi-box-seam"></i>
                Inventario de Productos
            </h1>

            <p class="text-muted">
                Gestión y control del inventario de Joyeria Oro
            </p>

        </div>

        <div>

            <a asp-action="ReporteInventario"
                   class="btn btn-danger btn-custom">

                <i class="bi bi-file-earmark-pdf-fill"></i>
                Descargar PDF

            </a>

        </div>

    </div>

    <!-- CARD -->
    <div class="card inventory-card">

        <div class="inventory-header">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h3 class="fw-bold mb-1">
                        Productos Registrados
                    </h3>

                    <p class="mb-0">
                        Total productos: @Model.Count()
                    </p>

                </div>

                <div>

                    <i class="bi bi-archive-fill"
                           style="font-size:60px; opacity:0.2;">
                    </i>

                </div>

            </div>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>

                        <tr>

                            <th class="p-3">Imagen</th>
                            <th class="p-3">Producto</th>
                            <th class="p-3">Descripción</th>
                            <th class="p-3">Precio</th>
                            <th class="p-3">Stock</th>
                            <th class="p-3">Estado</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- IMAGEN -->
                                <td class="p-3">

                                    @if (!string.IsNullOrEmpty(item.ImagenUrl))
                                    {
                                        <img src="@Url.Content("~/imagenes/productos/" + item.ImagenUrl)"
                                             class="product-img" />
                                    }
                                    else
                                    {
                                        <div class="empty-img">

                                            <i class="bi bi-image"></i>

                                        </div>
                                    }

                                </td>

                                <!-- NOMBRE -->
                                <td class="fw-semibold p-3">

                                    @item.Nombre

                                </td>

                                <!-- DESCRIPCION -->
                                <td class="text-muted p-3">

                                    @item.Descripcion

                                </td>

                                <!-- PRECIO -->
                                <td class="text-success fw-bold p-3">

                                    @((item.Precio ?? 0).ToString("C"))

                                </td>

                                <!-- STOCK -->
                                <td class="p-3">

                                    <span class="fw-bold">
                                        @(item.Stock ?? 0)
                                    </span>

                                </td>

                                <!-- ESTADO -->
                                <td class="p-3">

                                    @{
                                        int stock = item.Stock ?? 0;

                                        if (stock == 0)
                                        {
                                            <span class="badge bg-danger badge-custom">
                                                Agotado
                                            </span>
                                        }
                                        else if (stock <= 5)
                                        {
                                            <span class="badge bg-warning text-dark badge-custom">
                                                Stock Bajo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success badge-custom">
                                                Disponible
                                            </span>
                                        }
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>