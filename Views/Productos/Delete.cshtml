@model Joyeriaoro.Models.Producto

@{
    ViewData["Title"] = "Eliminar Producto";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>

    body {
        background: #f4f7fb;
    }

    .delete-card {
        border: none;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .delete-header {
        background: linear-gradient(135deg,#991b1b,#dc2626);
        color: white;
        padding: 30px;
    }

    .product-image {
        width: 100%;
        max-width: 260px;
        height: 260px;
        object-fit: cover;
        border-radius: 20px;
        border: 3px solid #e5e7eb;
    }

    .empty-image {
        width: 260px;
        height: 260px;
        background: #e5e7eb;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #9ca3af;
        font-size: 70px;
    }

    .info-card {
        background: white;
        border-radius: 18px;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        margin-bottom: 15px;
    }

    .label {
        color: #6b7280;
        font-size: 14px;
        margin-bottom: 5px;
    }

    .value {
        font-size: 22px;
        font-weight: 700;
        color: #111827;
    }

    .price {
        color: #198754;
    }

    .warning-box {
        border-radius: 18px;
        padding: 18px;
        background: #fff3cd;
        border: 1px solid #ffe69c;
    }

    .stock-badge {
        padding: 10px 18px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 600;
    }

</style>

<div class="container mt-5">

    <div class="card delete-card">

        <!-- HEADER -->
        <div class="delete-header">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h2 class="fw-bold">
                        <i class="bi bi-trash-fill"></i>
                        Eliminar Producto
                    </h2>

                    <p class="mb-0">
                        Confirmación de eliminación del producto
                    </p>

                </div>

                <div>

                    <i class="bi bi-exclamation-triangle-fill"
                           style="font-size:70px; opacity:0.2;">
                    </i>

                </div>

            </div>

        </div>

        <!-- BODY -->
        <div class="card-body p-5">

            <!-- ALERTA -->
            <div class="warning-box mb-4">

                <h5 class="fw-bold text-danger">

                    <i class="bi bi-exclamation-circle-fill"></i>
                    ¿Seguro que deseas eliminar este producto?

                </h5>

                <p class="mb-0 text-dark">

                    Esta acción no se puede deshacer.

                </p>

            </div>

            <div class="row g-5">

                <!-- IMAGEN -->
                <div class="col-md-4 text-center">

                    @if (!string.IsNullOrEmpty(Model.ImagenUrl))
                    {
                        <img src="@Url.Content("~/imagenes/productos/" + Model.ImagenUrl)"
                             class="product-image" />
                    }
                    else
                    {
                        <div class="empty-image mx-auto">

                            <i class="bi bi-image"></i>

                        </div>
                    }

                </div>

                <!-- INFORMACION -->
                <div class="col-md-8">

                    <!-- NOMBRE -->
                    <div class="info-card">

                        <p class="label">
                            Nombre del Producto
                        </p>

                        <div class="value">
                            @Model.Nombre
                        </div>

                    </div>

                    <!-- DESCRIPCION -->
                    <div class="info-card">

                        <p class="label">
                            Descripción
                        </p>

                        <div class="text-muted fs-5">

                            @(string.IsNullOrEmpty(Model.Descripcion)
                                ? "Sin descripción disponible"
                                : Model.Descripcion)

                        </div>

                    </div>

                    <div class="row">

                        <!-- PRECIO -->
                        <div class="col-md-6">

                            <div class="info-card">

                                <p class="label">
                                    Precio
                                </p>

                                <div class="value price">

                                    @((Model.Precio ?? 0).ToString("C"))

                                </div>

                            </div>

                        </div>

                        <!-- STOCK -->
                        <div class="col-md-6">

                            <div class="info-card">

                                <p class="label">
                                    Stock
                                </p>

                                <div class="value">

                                    @(Model.Stock ?? 0)

                                </div>

                                <div class="mt-2">

                                    @{
                                        int stock = Model.Stock ?? 0;

                                        if (stock == 0)
                                        {
                                            <span class="badge bg-danger stock-badge">
                                                Agotado
                                            </span>
                                        }
                                        else if (stock <= 5)
                                        {
                                            <span class="badge bg-warning text-dark stock-badge">
                                                Stock Bajo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success stock-badge">
                                                Disponible
                                            </span>
                                        }
                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- BOTONES -->
                    <form asp-action="Delete"
                          method="post"
                          class="mt-4">

                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex gap-3">

                            <button type="submit"
                                    class="btn btn-danger rounded-pill px-4 py-2">

                                <i class="bi bi-trash-fill"></i>
                                Eliminar

                            </button>

                            <a asp-action="Index"
                                   class="btn btn-secondary rounded-pill px-4 py-2">

                                <i class="bi bi-arrow-left"></i>
                                Cancelar

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>