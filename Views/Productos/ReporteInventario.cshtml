using iText.Kernel.Colors;
using iText.Kernel.Pdf;
using iText.Layout;
using iText.Layout.Borders;
using iText.Layout.Element;
using iText.Layout.Properties;
using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;
using Joyeriaoro.Data;

namespace Joyeriaoro.Controllers
{
public class ProductosController : Controller
{
private readonly ApplicationDbContext _context;

public ProductosController(ApplicationDbContext context)
{
_context = context;
}

// =========================================
// REPORTE PDF INVENTARIO PROFESIONAL
// =========================================
public async Task<IActionResult>
ReporteInventario()
{
var productos = await _context.Productos
.OrderBy(p => p.Nombre)
.Select(p => new
{
Nombre = p.Nombre ?? "",
Descripcion = p.Descripcion ?? "",
Precio = p.Precio,
Stock = p.Stock
})
.ToListAsync();

using var ms = new MemoryStream();

// ============================
// CREAR PDF
// ============================
var writer = new PdfWriter(ms);

var pdf = new PdfDocument(writer);

var document = new Document(pdf);

// ============================
// TITULO EMPRESA
// ============================
var titulo = new Paragraph("JOYERIA ORO")
.SetFontSize(24)
.SetBold()
.SetTextAlignment(TextAlignment.CENTER)
.SetFontColor(ColorConstants.DARK_GRAY);

document.Add(titulo);

// ============================
// SUBTITULO
// ============================
var subtitulo = new Paragraph("Reporte General de Inventario")
.SetFontSize(16)
.SetTextAlignment(TextAlignment.CENTER)
.SetMarginBottom(5);

document.Add(subtitulo);

// ============================
// FECHA
// ============================
var fecha = new Paragraph($"Fecha: {DateTime.Now:dd/MM/yyyy hh:mm tt}")
.SetFontSize(10)
.SetTextAlignment(TextAlignment.RIGHT)
.SetFontColor(ColorConstants.GRAY);

document.Add(fecha);

document.Add(new Paragraph("\n"));

// ============================
// TABLA
// ============================
float[] columnas =
{
4,
6,
3,
2,
3
};

var table = new Table(columnas)
.UseAllAvailableWidth();

// ============================
// HEADERS
// ============================

table.AddHeaderCell(CrearHeader("Producto"));
table.AddHeaderCell(CrearHeader("Descripción"));
table.AddHeaderCell(CrearHeader("Precio"));
table.AddHeaderCell(CrearHeader("Stock"));
table.AddHeaderCell(CrearHeader("Estado"));

// ============================
// FILAS
// ============================

decimal totalInventario = 0;

foreach (var p in productos)
{
totalInventario += p.Precio * p.Stock;

string estado = "Disponible";

if (p.Stock <= 0)
{
estado = "Agotado";
}
else if (p.Stock <= 5)
{
estado = "Stock Bajo";
}

table.AddCell(CrearCelda(p.Nombre));
table.AddCell(CrearCelda(p.Descripcion));
table.AddCell(CrearCelda(p.Precio.ToString("C")));
table.AddCell(CrearCelda(p.Stock.ToString()));
table.AddCell(CrearCelda(estado));
}

document.Add(table);

document.Add(new Paragraph("\n"));

// ============================
// RESUMEN
// ============================

var resumen = new Div()
.SetBackgroundColor(new DeviceRgb(245, 245, 245))
.SetPadding(15)
.SetBorderRadius(new BorderRadius(10));

resumen.Add(new Paragraph("RESUMEN GENERAL")
.SetBold()
.SetFontSize(14));

resumen.Add(new Paragraph($"Total Productos: {productos.Count}"));

resumen.Add(new Paragraph($"Valor Total Inventario: {totalInventario:C}")
.SetBold()
.SetFontColor(ColorConstants.BLUE));

document.Add(resumen);

document.Add(new Paragraph("\n"));

// ============================
// FOOTER
// ============================

var footer = new Paragraph("Documento generado automáticamente por Joyeria Oro")
.SetFontSize(9)
.SetFontColor(ColorConstants.GRAY)
.SetTextAlignment(TextAlignment.CENTER);

document.Add(footer);

document.Close();

return File(
ms.ToArray(),
"application/pdf",
$"ReporteInventario_{DateTime.Now:yyyyMMddHHmmss}.pdf"
);
}

// =========================================
// HEADER TABLA
// =========================================
private Cell CrearHeader(string texto)
{
return new Cell()
.Add(new Paragraph(texto)
.SetBold()
.SetFontColor(ColorConstants.WHITE))
.SetBackgroundColor(new DeviceRgb(17, 24, 39))
.SetPadding(8)
.SetTextAlignment(TextAlignment.CENTER);
}

// =========================================
// CELDAS TABLA
// =========================================
private Cell CrearCelda(string texto)
{
return new Cell()
.Add(new Paragraph(texto))
.SetPadding(6)
.SetBorder(new SolidBorder(ColorConstants.LIGHT_GRAY, 1));
}
}
}