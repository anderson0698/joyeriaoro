<!DOCTYPE html>
<html lang="es">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Joyeria Oro
    </title>

    <!-- BOOTSTRAP -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- ICONOS -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Joyeriaoro.styles.css"
          asp-append-version="true" />

    <style>

            body {
                background: #f4f7fb;
                font-family: 'Segoe UI', sans-serif;
            }

            /* =========================
                       NAVBAR
                    ========================== */

            .navbar-custom {
                background: #0f172a;
                padding: 14px 0;
                box-shadow: 0 4px 20px rgba(0,0,0,.08);
            }

            .navbar-brand {
                font-size: 28px;
                font-weight: 800;
                color: white !important;
            }

            .btn-custom {
                border-radius: 30px;
                padding: 10px 20px;
                font-weight: 600;
            }

            /* =========================
                       CONTENIDO
                    ========================== */

            .main-content {
                min-height: 80vh;
            }

            /* =========================
                       FOOTER
                    ========================== */

            footer {
                background: white;
                padding: 20px 0;
                margin-top: 40px;
                border-top: 1px solid #e5e7eb;
            }

    </style>

</head>

<body>

    <!-- =========================
         NAVBAR
    ========================== -->

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">

            <div class="container">

                <!-- LOGO -->
                <a class="navbar-brand"
                       asp-controller="Home"
                       asp-action="Index">

                    💎 Joyeria Oro

                </a>

                <!-- MENU RESPONSIVE -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarMenu">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse"
                     id="navbarMenu">

                    <!-- IZQUIERDA -->
                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">

                            <a class="nav-link text-white"
                                   asp-controller="Home"
                                   asp-action="Index">

                                Inicio

                            </a>

                        </li>

                    </ul>

                    <!-- DERECHA -->
                    <div class="d-flex gap-2 flex-wrap">

                        <!-- SI ESTA LOGUEADO -->
                        @if (User.Identity != null &&
                                                                        User.Identity.IsAuthenticated)
                        {
                            <!-- DASHBOARD -->
                            <a asp-controller="Home"
                                   asp-action="Dashboard"
                                   class="btn btn-warning btn-custom">

                                <i class="bi bi-speedometer2"></i>
                                Dashboard

                            </a>

                            <!-- PRODUCTOS -->
                            <a asp-controller="Productos"
                                   asp-action="Index"
                                   class="btn btn-primary btn-custom">

                                <i class="bi bi-box-seam"></i>
                                Productos

                            </a>

                            <!-- INVENTARIO -->
                            <a asp-controller="Productos"
                                   asp-action="Inventario"
                                   class="btn btn-info text-white btn-custom">

                                <i class="bi bi-clipboard-data"></i>
                                Inventario

                            </a>

                            <!-- REPORTES -->
                            <a asp-controller="Productos"
                                   asp-action="ReporteInventario"
                                   class="btn btn-dark btn-custom">

                                <i class="bi bi-file-earmark-pdf"></i>
                                Reportes

                            </a>

                            <!-- CERRAR SESION -->
                            <a asp-controller="Usuarios"
                                   asp-action="Logout"
                                   class="btn btn-outline-light btn-custom">

                                <i class="bi bi-box-arrow-right"></i>
                                Salir

                            </a>
                        }
                        else
                        {
                            <!-- SOLO LOGIN -->
                            <a asp-controller="Usuarios"
                                   asp-action="Login"
                                   class="btn btn-light btn-custom">

                                <i class="bi bi-box-arrow-in-right"></i>
                                Iniciar Sesión

                            </a>
                        }

                    </div>

                </div>

            </div>

        </nav>

    </header>

    <!-- =========================
         CONTENIDO
    ========================== -->

    <div class="container main-content">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>

    <!-- =========================
         FOOTER
    ========================== -->

    <footer class="text-center text-muted">

        <div class="container">

            <h5 class="fw-bold">
                💎 Joyeria Oro
            </h5>

            <p class="mb-2">
                Sistema Profesional de Gestión e Inventario
            </p>

            <small>
                © 2026 Joyeria Oro - Todos los derechos reservados
            </small>

        </div>

    </footer>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>