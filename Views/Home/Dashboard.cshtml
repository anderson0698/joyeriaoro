@{
    ViewData["Title"] = "Dashboard";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>

    body{
        background:#f4f7fb;
    }

    .dashboard-title{
        font-weight:700;
        color:#1f2937;
    }

    .welcome-card{
        background: linear-gradient(135deg,#111827,#1e3a8a);
        border:none;
        border-radius:20px;
        color:white;
        overflow:hidden;
        box-shadow:0 10px 30px rgba(0,0,0,0.1);
    }

    .info-box{
        border:none;
        border-radius:18px;
        transition:0.3s;
        box-shadow:0 4px 15px rgba(0,0,0,0.06);
    }

    .info-box:hover{
        transform:translateY(-5px);
    }

    .info-icon{
        width:60px;
        height:60px;
        display:flex;
        align-items:center;
        justify-content:center;
        border-radius:15px;
        font-size:28px;
    }

    .quick-btn{
        border-radius:14px;
        padding:12px 20px;
        font-weight:600;
    }

    .section-card{
        border:none;
        border-radius:20px;
        box-shadow:0 5px 20px rgba(0,0,0,0.05);
    }

    .table thead{
        background:#111827;
        color:white;
    }

    .alert-custom{
        border-radius:18px;
        border:none;
        box-shadow:0 4px 15px rgba(0,0,0,0.08);
    }

</style>

<div class="container-fluid mt-4">

    <!-- TITULO -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="dashboard-title">
                <i class="bi bi-gem"></i> Dashboard - Joyeria Oro
            </h1>

            <p class="text-muted">
                Panel administrativo del sistema
            </p>
        </div>

        <div>
            <span class="badge bg-dark p-3">
                <i class="bi bi-person-circle"></i>
                @ViewBag.Rol
            </span>
        </div>

    </div>

    <!-- ALERTA STOCK -->
    @if (ViewBag.StockBajo > 0)
    {
        <div class="alert alert-warning alert-custom mb-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="fw-bold">
                        ⚠ Productos con stock bajo
                    </h5>

                    <p class="mb-2">
                        Actualmente existen
                        <strong>@ViewBag.StockBajo productos</strong>
                        con pocas unidades disponibles.
                    </p>

                    <ul>
                        @foreach (var p in ViewBag.ProductosStockBajo)
                        {
                            <li>
                                <strong>@p.Nombre</strong>
                                - Stock: @p.Stock
                            </li>
                        }
                    </ul>
                </div>

                <div>
                    <a asp-controller="Productos"
                       asp-action="Inventario"
                       class="btn btn-dark rounded-pill px-4">
                        Ver Inventario
                    </a>
                </div>

            </div>

        </div>
    }

    <!-- BIENVENIDA -->
    <div class="card welcome-card mb-4">

        <div class="card-body p-4">

            <div class="row align-items-center">

                <div class="col-md-8">

                    <h2 class="fw-bold">
                        Bienvenido, @ViewBag.Nombre 👋
                    </h2>

                    <p class="mb-1">
                        <i class="bi bi-envelope-fill"></i>
                        @ViewBag.Email
                    </p>

                    <p class="mb-0">
                        <i class="bi bi-shield-lock-fill"></i>
                        Rol: @ViewBag.Rol
                    </p>

                </div>

                <div class="col-md-4 text-end">

                    <i class="bi bi-bar-chart-line"
                       style="font-size:90px; opacity:0.2;">
                    </i>

                </div>

            </div>

        </div>

    </div>

    <!-- TARJETAS -->
    <div class="row g-4 mb-4">

        <div class="col-md-3">

            <div class="card info-box">

                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <p class="text-muted mb-1">Total Productos</p>
                        <h2 class="fw-bold contador">@ViewBag.TotalProductos</h2>
                    </div>

                    <div class="info-icon bg-primary text-white">
                        <i class="bi bi-box-seam"></i>
                    </div>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card info-box">

                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <p class="text-muted mb-1">Disponibles</p>
                        <h2 class="fw-bold contador text-success">@ViewBag.Disponibles</h2>
                    </div>

                    <div class="info-icon bg-success text-white">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card info-box">

                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <p class="text-muted mb-1">Stock Bajo</p>
                        <h2 class="fw-bold contador text-warning">@ViewBag.StockBajo</h2>
                    </div>

                    <div class="info-icon bg-warning text-dark">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card info-box">

                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <p class="text-muted mb-1">Agotados</p>
                        <h2 class="fw-bold contador text-danger">@ViewBag.Agotados</h2>
                    </div>

                    <div class="info-icon bg-danger text-white">
                        <i class="bi bi-x-circle-fill"></i>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- VALOR INVENTARIO -->
    <div class="card section-card mb-4">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="text-muted">
                        Valor Total del Inventario
                    </h5>

                    <h1 class="fw-bold text-dark">
                        @String.Format("{0:C}", ViewBag.ValorInventario)
                    </h1>
                </div>

                <div>
                    <i class="bi bi-currency-dollar text-success"
                       style="font-size:70px;">
                    </i>
                </div>

            </div>

        </div>

    </div>

    <!-- BOTONES -->
    <div class="card section-card mb-4">

        <div class="card-body">

            <h4 class="mb-4 fw-bold">
                Accesos Rápidos
            </h4>

            <div class="d-flex flex-wrap gap-3">

                <!-- PRODUCTOS -->
                <a asp-controller="Productos"
                   asp-action="Index"
                   class="btn btn-primary quick-btn">
                    <i class="bi bi-box"></i>
                    Productos
                </a>

                <!-- INVENTARIO -->
                <a asp-controller="Productos"
                   asp-action="Inventario"
                   class="btn btn-success quick-btn">
                    <i class="bi bi-archive"></i>
                    Inventario
                </a>

                <!-- PDF -->
                <a asp-controller="Productos"
                   asp-action="ReporteInventario"
                   class="btn btn-danger quick-btn">
                    <i class="bi bi-file-earmark-pdf"></i>
                    Descargar PDF
                </a>

                <!-- REGISTRAR USUARIO -->
                <a asp-controller="Usuarios"
                   asp-action="Registrar"
                   class="btn btn-dark quick-btn">
                    <i class="bi bi-person-plus-fill"></i>
                    Registrar Usuario
                </a>

            </div>

        </div>

    </div>

    <!-- GRAFICOS -->
    <div class="row">

        <div class="col-md-6 mb-4">

            <div class="card section-card">

                <div class="card-body">

                    <h5 class="fw-bold mb-4">
                        Estado del Inventario
                    </h5>

                    <canvas id="graficoInventario"></canvas>

                </div>

            </div>

        </div>

        <div class="col-md-6 mb-4">

            <div class="card section-card">

                <div class="card-body">

                    <h5 class="fw-bold mb-4">
                        Ventas por Mes
                    </h5>

                    <canvas id="graficoVentas"></canvas>

                </div>

            </div>

        </div>

    </div>

    <!-- TOP PRODUCTOS -->
    <div class="card section-card mb-5">

        <div class="card-body">

            <h4 class="fw-bold mb-4">
                🔥 Productos Más Vendidos
            </h4>

            <div class="table-responsive">

                <table class="table align-middle table-hover">

                    <thead>

                        <tr>
                            <th>Producto</th>
                            <th>Cantidad Vendida</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var p in ViewBag.TopProductos)
                        {
                            <tr>
                                <td class="fw-semibold">@p.Nombre</td>
                                <td>
                                    <span class="badge bg-success p-2">
                                        @p.Cantidad
                                    </span>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

    // =========================
    // INVENTARIO
    // =========================

    var ctx = document.getElementById('graficoInventario');

    new Chart(ctx, {

        type: 'doughnut',

        data: {

            labels: ['Disponibles', 'Stock Bajo', 'Agotados'],

            datasets: [{

                data: [
                    @ViewBag.Disponibles,
                    @ViewBag.StockBajo,
                    @ViewBag.Agotados
                ],

                backgroundColor: [
                    '#198754',
                    '#ffc107',
                    '#dc3545'
                ]

            }]
        }

    });

    // =========================
    // VENTAS
    // =========================

    var datosVentas = [];

    @foreach (var v in ViewBag.VentasMes)
    {
        <text>
            datosVentas.push(@v.Total);
        </text>
    }

    var ctxVentas = document.getElementById('graficoVentas');

    new Chart(ctxVentas, {

        type: 'line',

        data: {

            labels: [
                'Enero','Febrero','Marzo','Abril','Mayo','Junio',
                'Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'
            ],

            datasets: [{

                label: 'Ventas',

                data: datosVentas,

                borderColor: '#0d6efd',

                backgroundColor: 'rgba(13,110,253,0.1)',

                tension: 0.4,

                fill: true

            }]
        }

    });

</script>