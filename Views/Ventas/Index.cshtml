@model IEnumerable<Joyeriaoro.Models.Venta>

<h2>Ventas</h2>

<a asp-action="Create" class="btn btn-success mb-3">
    Nueva Venta
</a>

<table class="table table-bordered table-striped">

    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Fecha</th>
            <th>Total</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var v in Model)
        {
            <tr>

                <td>@v.VentaId</td>

                <td>
                    @v.Fecha.ToString("dd/MM/yyyy HH:mm")
                </td>

                <td>
                    @String.Format("{0:C}", v.Total)
                </td>

                <td>

                    <a asp-action="Factura"
                       asp-route-id="@v.VentaId"
                       class="btn btn-danger btn-sm">
                        Factura PDF
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>

<br />

<a asp-controller="Productos"
   asp-action="ReporteInventario"
   class="btn btn-primary">

    Descargar Reporte Inventario PDF

</a>